# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Qual provedor de IA usar: "ollama" (local, grátis) ou "claude" (API da Anthropic)
LLM_PROVIDER=claude

# Como o chat decide o que fazer: "agente" (um agente com ferramentas decide tudo) ou
# "classificador" (a pergunta é classificada antes). Vazio = agente com o Claude, classificador com o Ollama.
CHAT_MODO=

# Modelo do Ollama (precisa estar baixado: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Modelo do Ollama que lê imagens (ollama pull qwen2.5vl:3b)
OLLAMA_MODELO_VISAO=qwen2.5vl:3b

# Só necessário quando LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

