# Modelo do Ollama (precisa estar baixado: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Modelo do Ollama que lê imagens (ollama pull qwen2.5vl:3b)
OLLAMA_MODELO_VISAO=qwen2.5vl:3b

# Só necessário quando LLM_PROVIDER=claude
ANTHROPIC_API_KEY=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
