# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Qual provedor de IA usar: "ollama" (local, grátis) ou "claude" (API da Anthropic)
LLM_PROVIDER=ollama

# Modelo do Ollama (precisa estar baixado: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Modelo do Ollama que lê imagens (ollama pull qwen2.5vl:3b)
OLLAMA_MODELO_VISAO=qwen2.5vl:3b

# Só necessário quando LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
